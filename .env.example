# ==============================================================================
# 1. Wyze Cam Pan v3 / docker-wyze-bridge 設定
#    APIキー発行先: https://support.wyze.com/hc/en-us/articles/16129834216731
#    (Wyze Developer Portal: https://developer-api-console.wyze.com/)
# ==============================================================================
WYZE_EMAIL=your_wyze_email@example.com
WYZE_PASSWORD=your_wyze_password
API_ID=your_wyze_api_key_id
API_KEY=your_wyze_api_key

# Wyzeアプリ上で付けたカメラ名（docker-wyze-bridgeのURIスラグ: 小文字・ハイフン区切り）
# 例: カメラ名が "Wyze Cam Pan" の場合は "wyze-cam-pan"
WYZE_CAM_NAME=wyze-cam-pan

# docker-wyze-bridge のWeb/APIエンドポイント
WYZE_BRIDGE_HOST=http://localhost:5050
# docker-wyze-bridge のWebUI認証を無効化してローカルAPI呼び出しを簡単にする場合は WB_AUTH=false
WB_AUTH=false

# PTZ制御方式:
#   "degree" : /api/<cam>/rotary_degree/<pan>,<tilt> （絶対角度指定）
#   "action" : /api/<cam>/rotary_action/<left|right|up|down|stop> （相対ステップ移動）
#   "both"   : degreeを優先し、失敗時にactionへフォールバック
WYZE_PTZ_METHOD=degree

# ==============================================================================
# 2. カメラ映像ソース設定
# ==============================================================================
# 静止カメラ（ATOM Cam 2）の映像ソース
# - ATOM Cam 2 のRTSPを使う場合: "rtsp://<USER>:<PASS>@<ATOM_CAM_IP>/live"
# - Mac内蔵カメラを使う場合: "0"
STATIC_CAM_SOURCE=0

# Wyze Cam Pan v3 自身の映像ソース（モード2でWyze自身の視点で探索・追従する場合）
# - docker-wyze-bridge のRTSP: "rtsp://localhost:8554/wyze-cam-pan"
# - またはスナップショットAPI利用時は空欄でも可
WYZE_CAM_RTSP=rtsp://localhost:8554/wyze-cam-pan

# ==============================================================================
# 3. ROS2 (rosbridge) 設定
# ==============================================================================
ROSBRIDGE_HOST=localhost
ROSBRIDGE_PORT=9090
